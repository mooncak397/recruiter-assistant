# Copy to .env and fill in. Names only here, never real values.
GEMINI_API_KEY=
MODEL_APP=gemini-3.5-flash-lite
MODEL_JUDGE=gemma-4-31b-it
# Optional: use Claude instead of Gemini (the default is Gemini, the free tier)
# PROVIDER_APP=anthropic
# PROVIDER_JUDGE=anthropic
# ANTHROPIC_API_KEY=

# Server (app/main.py). All optional in dev; set them as Space secrets / variables in production.
# SESSION_HMAC_KEY=        # signs session tokens; unset = random per process
# ALLOWED_ORIGIN=          # the one CORS origin, e.g. the GitHub Pages URL; unset = no browser origin allowed
# TURNSTILE_SECRET=        # Cloudflare Turnstile; unset = check skipped (dev only)
# RESEND_API_KEY=          # unset = /contact answers 503
# CONTACT_TO=              # the one recipient (the Resend account address)
# TRUST_PROXY=true        # true behind the HF proxy (client IP = last X-Forwarded-For entry); false = socket address
# CONTACT_FROM=            # default: Recruiter assistant <onboarding@resend.dev>
# Limits (defaults): SESSIONS_PER_IP_HOUR=10 CHAT_PER_IP_HOUR=20 CHAT_PER_DAY=140 CONTACT_PER_IP_DAY=1 CONTACT_PER_DAY=5
